{
  "name": "交流方式观展手册 · 软触控制台",
  "version": "1.0",
  "status": "implemented in production UI; canonical source for generated CSS tokens",
  "theme": "dark",
  "colors": {
    "canvas": "#1B2223",
    "panel": "#252C2E",
    "control": "#323C3D",
    "elevated": "#3B4647",
    "inset": "#141A1B",
    "navigationSelected": "#111617",
    "border": "#4D5A5B",
    "text": "#E4E8E4",
    "muted": "#AAB7B4",
    "primary": "#A9C46B",
    "primaryHover": "#BBD681",
    "primaryPressed": "#90AA58",
    "onPrimary": "#141A1B",
    "activity": "#F6A630",
    "course": "#78B8B0",
    "warning": "#E4BA69",
    "danger": "#E69A90"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radius": {
    "tag": 4,
    "control": 6,
    "panel": 8
  },
  "type": {
    "title": {
      "size": 24,
      "weight": 650,
      "lineHeight": 1.4
    },
    "section": {
      "size": 18,
      "weight": 600,
      "lineHeight": 1.5
    },
    "body": {
      "size": 14,
      "weight": 400,
      "lineHeight": 1.8
    },
    "meta": {
      "size": 12,
      "weight": 400,
      "lineHeight": 1.65
    },
    "inputMobile": {
      "size": 16
    },
    "technical": "monospace for dates, times and booth codes only"
  },
  "dimensions": {
    "minimumTouchTarget": 44,
    "controlHeight": 44,
    "compactVisualHeight": 36,
    "compactTouchHeight": 44,
    "desktopRail": 88,
    "tabletRail": 80,
    "desktopHeader": 72,
    "mobileHeader": 62,
    "mobileDetailHeight": "94dvh"
  },
  "material": {
    "raised": "inset 0 1px 0 rgb(255 255 255 / 0.08), 0 2px 2px rgb(0 0 0 / 0.25)",
    "inset": "inset 0 1px 2px rgb(0 0 0 / 0.3)",
    "primary": "inset 0 1px 0 rgb(255 255 255 / 0.25), 0 2px 2px rgb(0 0 0 / 0.25)",
    "pressed": "inset 0 2px 2px rgb(0 0 0 / 0.25)",
    "focus": "2px solid #A9C46B; offset 2px",
    "texture": "no raster texture behind text; shallow gradient on interactive surfaces only"
  },
  "motion": {
    "feedback": "120ms",
    "content": "160ms",
    "enter": "240ms",
    "exit": "180ms",
    "reducedMotion": "instant"
  },
  "responsive": {
    "mobile": "<640px; header menu; stacked facts; 94dvh detail modal",
    "tablet": "640–1023px; 80px rail; large detail modal",
    "desktop": "≥1024px; 88px rail; source and detail each half of remaining space"
  },
  "separators": "one chapter boundary; no final list-row bottom border; omit empty sections and navigation items"
}
