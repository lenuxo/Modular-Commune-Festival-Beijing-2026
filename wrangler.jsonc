{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modular-commune-festival-beijing-2026",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
